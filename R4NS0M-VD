local function hudTick()
    if not HUD.On then HudLbl.Visible = false return end
    local lines = {}
    local total, left, known = 0, 0, false
    for g in pairs(Cache.Generator) do
        if g.Parent then
            total = total + 1
            local p = genProgress(g)
            if p ~= nil then known = true end
            if not genDone(g) then left = left + 1 end
        end
    end
    if total > 0 then
        table.insert(lines, known and ("<font color='#fb923c'>Generators: " .. left .. "/" .. total .. " left</font>")
            or ("<font color='#fb923c'>Generators: " .. total .. "</font>"))
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local r = roleOf(p)
            if r == "Killer" or r == "Survivor" then
                local c = p.Character
                if c then
                    local col = (r == "Killer") and Color3.fromRGB(255, 70, 90) or Color3.fromRGB(80, 255, 130)
                    local h = c:FindFirstChildOfClass("Humanoid")
                    local hp = h and h.MaxHealth > 0 and math.floor(h.Health / h.MaxHealth * 100) or 0
                    local pr = c:FindFirstChild("HumanoidRootPart")
                    local d = pr and math.floor(distTo(pr.Position)) or 0
                    local st = stateOf(c)
                    table.insert(lines, string.format("<font color='#%s'>%s</font> %d%% %s %dm", col:ToHex(), p.Name, hp, st ~= "OK" and ("[" .. st .. "]") or "", d))
                end
            end
        end
    end
    HudLbl.Text = table.concat(lines, "\n")
    HudLbl.Visible = #lines > 0
end

