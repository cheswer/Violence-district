        if c:GetAttribute("IsStunned") then c:SetAttribute("IsStunned", false) end
        if h.WalkSpeed < 2 and not c:GetAttribute("IsCarrying") then
            h.WalkSpeed = (type(c:GetAttribute("Speed")) == "number") and c:GetAttribute("Speed") or math.max(K.Peak, 16)
