    pcall(function() LocalPlayer.CameraMaxZoomDistance = origZoom end)
    pcall(function() if Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = origFOV end end)
    for part, m in pairs(MatOrig) do pcall(function() part.Material = m end) end
end)

local function applyEnv()
    if Env.FullBright then
        Lighting.Brightness = 2.5
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.fromRGB(180, 180, 180)
        Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
        Lighting.ExposureCompensation = 0.3
    end
    if Env.NoFog then
        Lighting.FogEnd = 1e6
        Lighting.FogStart = 1e6
        for _, a in ipairs(Lighting:GetChildren()) do
            if a:IsA("Atmosphere") then
                if AtmoOrig[a] == nil then AtmoOrig[a] = a.Density end
                a.Density = 0
            end
        end
    end
    if Env.NoShadows then Lighting.GlobalShadows = false end
    if Env.Zoom then LocalPlayer.CameraMaxZoomDistance = 9999 end
    if Env.FOV and Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = Env.FOVValue end
end

local function setLowGfx(v)
    Env.LowGfx = v
    if v then
        for _, o in ipairs(Workspace:GetDescendants()) do
            if o:IsA("BasePart") and o.Material ~= Enum.Material.SmoothPlastic then
                MatOrig[o] = o.Material
                o.Material = Enum.Material.SmoothPlastic
            end
        end
    else
        for part, m in pairs(MatOrig) do pcall(function() part.Material = m end) end
        table.clear(MatOrig)
    end
end

