local LightOrig
local fbWas, fogWas = false, false
local function saveLight()
    if LightOrig then return end
    LightOrig = {
        Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime, Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient, GlobalShadows = Lighting.GlobalShadows,
        FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart,
    }
end

local function envTick()
    if S.FullBright then
        saveLight(); fbWas = true
        Lighting.Brightness = S.BrightLevel
        Lighting.ClockTime = 12
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        Lighting.GlobalShadows = false
    elseif fbWas and LightOrig then
        fbWas = false
        Lighting.Brightness = LightOrig.Brightness; Lighting.ClockTime = LightOrig.ClockTime
        Lighting.Ambient = LightOrig.Ambient; Lighting.OutdoorAmbient = LightOrig.OutdoorAmbient
        Lighting.GlobalShadows = LightOrig.GlobalShadows
    end
    if S.NoFog then
        saveLight(); fogWas = true
        Lighting.FogEnd = 1e5; Lighting.FogStart = 1e5
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then atm.Density = 0 end
    elseif fogWas and LightOrig then
        fogWas = false
        Lighting.FogEnd = LightOrig.FogEnd; Lighting.FogStart = LightOrig.FogStart
    end
end

local MatBackup = {}
local function setLowGfx(on)
    if on then
        task.spawn(function()
            local n = 0
            local rootInst = Workspace:FindFirstChild("Map") or Workspace
            for _, o in ipairs(rootInst:GetDescendants()) do
                if not S.LowGfx then break end
                if o:IsA("BasePart") and not o:IsDescendantOf(Players) and o.Material ~= Enum.Material.SmoothPlastic then
                    if not MatBackup[o] then MatBackup[o] = o.Material end
                    o.Material = Enum.Material.SmoothPlastic
                end
                n += 1
                if n % 500 == 0 then task.wait() end
            end
        end)
    else
        for o, m in pairs(MatBackup) do
            if o and o.Parent then pcall(function() o.Material = m end) end
            MatBackup[o] = nil
        end
    end
end

