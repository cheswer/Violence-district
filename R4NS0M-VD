local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ESP"; ESPFolder.Parent = GuiHolder

local ESP = {}      -- [inst] = entry
local MapObjs = {}  -- [inst] = categoria (indice barato, sin crear nada)

local MapNames = {
    Generator = "Generators", Pallet = "Pallets", Palletwrong = "Pallets",
    Window = "Windows", Hook = "Hooks", Gate = "Gates",
}
local MapLabel = { Generators = "Generator", Pallets = "Pallet", Windows = "Vault", Hooks = "Hook", Gates = "Exit" }

local function adorneePart(inst)
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        return inst.PrimaryPart or inst:FindFirstChild("HumanoidRootPart") or inst:FindFirstChildWhichIsA("BasePart", true)
    end
end

local function destroyEntry(inst)
    local e = ESP[inst]
    if not e then return end
    pcall(function() e.hl:Destroy() end)
    pcall(function() e.gui:Destroy() end)
    ESP[inst] = nil
end

local function ensureEntry(inst, part, isPlayer)
    local e = ESP[inst]
    if e then
        if not e.part or not e.part.Parent then e.part = part; e.gui.Adornee = part end
        return e
    end
    if not part then return nil end
    local hl = Instance.new("Highlight")
    hl.Adornee = inst; hl.Enabled = false; hl.Parent = ESPFolder
    local gui = Instance.new("BillboardGui")
    gui.Adornee = part; gui.Size = UDim2.fromOffset(170, 28)
    gui.StudsOffset = Vector3.new(0, isPlayer and 3 or 2, 0)
    gui.AlwaysOnTop = true; gui.Enabled = false; gui.Parent = ESPFolder
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.fromScale(1, 1); lbl.BackgroundTransparency = 1
    lbl.TextStrokeTransparency = 0; lbl.Parent = gui
    e = { hl = hl, gui = gui, lbl = lbl, part = part, player = isPlayer, item = "None" }
    ESP[inst] = e
    return e
end

local function catAllowed(cat)
    if not S.TeamCheck then return true end
    local t = teamName(LocalPlayer)
    if t:find("Spectator") then return false end
    if t == "Survivors" and cat == "Hooks" then return false end
    if t == "Killer" and (cat == "Generators" or cat == "Pallets" or cat == "Windows" or cat == "Gates") then return false end
    return true
end

local function getItem(char)
    for _, n in ipairs(ItemsList) do
        if char:FindFirstChild(n, true) then return n end
    end
    return "None"
end

local function styleEntry(e, cat, text)
    local color = ESPColors[cat]
    e.hl.FillColor = color
    e.hl.OutlineColor = Color3.new(1, 1, 1)
    e.hl.FillTransparency = S.OnlyOutline and 1 or 0.5
    e.hl.DepthMode = S.OnlyVisual and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
    e.hl.Enabled = true
    e.gui.AlwaysOnTop = not S.OnlyVisual
    e.gui.Enabled = S.ShowLabels
    e.lbl.Text = text
    e.lbl.TextColor3 = color
    e.lbl.Font = S.LabelFont
    e.lbl.TextSize = S.LabelSize
end

local function hasRegisteredAncestor(o)
    local p = o.Parent
    while p and p ~= Workspace do
        if MapObjs[p] then return true end
        p = p.Parent
    end
    return false
end

local function classify(o)
    local cat = MapNames[o.Name]
    if not cat then return end
    if not (o:IsA("Model") or o:IsA("BasePart")) then return end
    if o.Parent and o.Parent.Name == o.Name then return end
    if hasRegisteredAncestor(o) then return end
    return cat
end

local function indexMapObject(o)
    local cat = classify(o)
    if cat then MapObjs[o] = cat end
end

local mapConn
local function hookMap(map)
    if mapConn then mapConn:Disconnect(); mapConn = nil end
    for inst in pairs(MapObjs) do MapObjs[inst] = nil; destroyEntry(inst) end
    if not map then return end
    task.spawn(function()
        local n = 0
        for _, o in ipairs(map:GetDescendants()) do
            indexMapObject(o)
            n += 1
            if n % 400 == 0 then task.wait() end
        end
    end)
    mapConn = map.DescendantAdded:Connect(indexMapObject)
    bind(mapConn)
end

hookMap(Workspace:FindFirstChild("Map"))
bind(Workspace.ChildAdded:Connect(function(c)
    if c.Name == "Map" then task.wait(0.5); hookMap(c) end
end))

local function espRefresh()
    local lr = getRoot()
    local c = cam()
    local origin = (lr and lr.Position) or (c and c.CFrame.Position) or Vector3.zero
    local itemScan = (tick() % 1) < S.ESPRate + 0.01

    -- jugadores
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            local cat = playerCat(p)
            local rootP = char and getRoot(char)
            local on = cat and rootP and ESPEnabled[cat] and catAllowed(cat)
            if on then
                local d = (rootP.Position - origin).Magnitude
                if d > S.MaxDist then on = false else
                    local e = ensureEntry(char, char:FindFirstChild("Head") or rootP, true)
                    if e then
                        if itemScan and cat == "Survivors" then e.item = getItem(char) end
                        local dtxt = S.ShowDist and (" | " .. math.floor(d) .. "m") or ""
                        local text
                        if cat == "Killer" then text = "[KILLER] " .. p.Name .. dtxt
                        elseif cat == "Survivors" then text = p.Name .. " | " .. e.item .. dtxt
                        else text = "[SPEC] " .. p.Name end
                        styleEntry(e, cat, text)
                    end
                end
            end
            if not on and char and ESP[char] then
                ESP[char].hl.Enabled = false; ESP[char].gui.Enabled = false
            end
        end
    end
    -- limpiar personajes que ya no existen
    for inst, e in pairs(ESP) do
        if e.player and (not inst.Parent) then destroyEntry(inst) end
    end

    -- objetos del mapa
    for inst, cat in pairs(MapObjs) do
        if not inst.Parent or not inst:IsDescendantOf(Workspace) then
            MapObjs[inst] = nil; destroyEntry(inst)
        else
            local on = ESPEnabled[cat] and catAllowed(cat)
            if on then
                local part = adorneePart(inst)
                if part then
                    local d = (part.Position - origin).Magnitude
                    if d <= S.MaxDist then
                        local e = ensureEntry(inst, part, false)
                        if e then
                            local base = (S.CustomText ~= "" and S.CustomText) or MapLabel[cat]
                            styleEntry(e, cat, S.ShowDist and (base .. " | " .. math.floor(d) .. "m") or base)
                        end
                    elseif ESP[inst] then
                        ESP[inst].hl.Enabled = false; ESP[inst].gui.Enabled = false
                    end
                end
            elseif ESP[inst] then
                destroyEntry(inst)
            end
        end
    end
end

task.spawn(function()
    while not Unloaded do
        pcall(espRefresh)
        task.wait(math.max(0.05, S.ESPRate))
    end
end)

