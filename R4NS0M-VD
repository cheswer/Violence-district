--// ==================== UI: CONFIGS ====================
local ConfigManager = Window.ConfigManager
local currentCfgName = "default"
local currentCfg

local function makeCfg(name)
    local create = ConfigManager and (ConfigManager.CreateConfig or ConfigManager.Config)
    if not create then return nil end
    local ok, cfg = pcall(create, ConfigManager, name)
    if not ok or not cfg then return nil end
    for key, el in pairs(Registered) do pcall(cfg.Register, cfg, key, el) end
    return cfg
end

local function listConfigs()
    local out = {}
    pcall(function()
        for _, n in ipairs(ConfigManager:AllConfigs()) do table.insert(out, n) end
    end)
    if #out == 0 then out = { "default" } end
    return out
end

local CfgDropdown
Tabs.Configs:Section({ Title = "Config Manager" })
Tabs.Configs:Paragraph({ Title = "How it works", Desc = "Pick or create a config, then Save / Load. Nothing loads automatically." })
Tabs.Configs:Input({ Title = "Config Name", Placeholder = "default", Value = "default", Callback = function(t)
    t = tostring(t or ""):gsub("[^%w_%- ]", "")
    if t ~= "" then currentCfgName = t end
end })
CfgDropdown = Tabs.Configs:Dropdown({ Title = "Saved Configs", Values = listConfigs(), Value = "default", Callback = function(v)
    currentCfgName = v
end })
local function refreshCfgList() pcall(function() CfgDropdown:Refresh(listConfigs()) end) end

Button(Tabs.Configs, "Save Config", "Saves every toggle, slider and color.", function()
    currentCfg = makeCfg(currentCfgName)
