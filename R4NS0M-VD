--// ============================ CACHE DEL MAPA ============================
local KindByName = { Generator = "Generator", Pallet = "Pallet", Palletwrong = "Pallet", Window = "Window", Hook = "Hook", Gate = "Gate" }
local Cache = { Generator = {}, Pallet = {}, Window = {}, Hook = {}, Gate = {}, Item = {} }
local MapRoot, MapConns = nil, {}
local Entries = {}
local removeEntry -- forward

local function tryRegister(o)
    if not (o:IsA("Model") or o:IsA("BasePart")) then return end
    local kind = KindByName[o.Name]
    if kind then
        local a = o.Parent
        while a and a ~= Workspace do
            if KindByName[a.Name] == kind then return end
            a = a.Parent
        end
        Cache[kind][o] = true
    elseif o:IsA("Model") and ItemSet[o.Name] and not insideCharacter(o) then
        Cache.Item[o] = true
    end
end

local function hookMap(m)
    for _, c in ipairs(MapConns) do pcall(function() c:Disconnect() end) end
    table.clear(MapConns)
    for _, k in pairs(Cache) do table.clear(k) end
    MapRoot = m
    if not m then return end
    for _, d in ipairs(m:GetDescendants()) do tryRegister(d) end
    table.insert(MapConns, m.DescendantAdded:Connect(tryRegister))
    table.insert(MapConns, m.DescendantRemoving:Connect(function(o)
        for _, k in pairs(Cache) do k[o] = nil end
        if removeEntry then removeEntry(o) end
    end))
end
Maid:Task(function() for _, c in ipairs(MapConns) do pcall(function() c:Disconnect() end) end end)

local function genProgress(g)
    for _, n in ipairs({ "Progress", "RepairProgress", "Percentage", "Percent", "GeneratorProgress" }) do
        local v = g:GetAttribute(n)
        if type(v) == "number" then
            if v <= 1 then v = v * 100 end
            return math.clamp(v, 0, 100)
        end
        local c = g:FindFirstChild(n, true)
        if c and (c:IsA("NumberValue") or c:IsA("IntValue")) then
            local x = c.Value
            if x <= 1 then x = x * 100 end
            return math.clamp(x, 0, 100)
        end
    end
    if g:GetAttribute("Completed") or g:GetAttribute("Repaired") or g:GetAttribute("Done") then return 100 end
    return nil
end

local function genDone(g)
    local p = genProgress(g)
    return p ~= nil and p >= 99.5
end

local function nearestOfKind(kind, filterFn)
    local r = getRoot()
    if not r then return nil end
    local best, bestD = nil, math.huge
    for inst in pairs(Cache[kind]) do
        if inst.Parent and (not filterFn or filterFn(inst)) then
            local p = pivotPos(inst)
            if p then
                local d = (p - r.Position).Magnitude
                if d < bestD then best, bestD = inst, d end
            end
        end
    end
    return best, bestD
end

