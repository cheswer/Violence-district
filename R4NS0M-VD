            local kr = kc and kc:FindFirstChild("HumanoidRootPart")
            local kh = kc and kc:FindFirstChildOfClass("Humanoid")
            local an = kh and kh:FindFirstChildOfClass("Animator")
            if kr and an and (kr.Position - r.Position).Magnitude <= AP.Range then
                for _, t in ipairs(an:GetPlayingAnimationTracks()) do
                    if t.IsPlaying and t.TimePosition < 0.45 and not parrySeen[t] and isAttackTrack(t) then
                        parrySeen[t] = true
                        doParry(kr)
                        break
                    end
                end
            end
        end
    end
end))

