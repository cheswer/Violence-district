UI_Button(TabSet, "Server Hop", "Salta a otro servidor publico con espacio.", function()
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    if ok and res and res.data then
        for _, s in ipairs(res.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                return
            end
        end
    end
    notify("Server Hop", "No encontre otro servidor.", 3, "x")
end)

Section(TabSet, "Debug")
UI_Button(TabSet, "Dump Remotes (consola + clipboard)", "Util si el juego se actualiza y algo deja de funcionar.", function()
    local out = {}
    local rem = ReplicatedStorage:FindFirstChild("Remotes")
    if not rem then notify("Dump", "No existe ReplicatedStorage.Remotes", 3, "x") return end
    for _, d in ipairs(rem:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            table.insert(out, d:GetFullName():gsub("^ReplicatedStorage%.", "") .. " [" .. d.ClassName .. "]")
        end
    end
    table.sort(out)
    local txt = table.concat(out, "\n")
    print("[R4NS0M] Remotes:\n" .. txt)
    if setclipboard then setclipboard(txt) end
    notify("Dump", #out .. " remotes (consola F9" .. (setclipboard and " + clipboard" or "") .. ")", 4, "terminal")
end)
