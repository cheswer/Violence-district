local function getChar(p) return (p or LocalPlayer).Character end
local function getRoot(p) local c = getChar(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(p) local c = getChar(p) return c and c:FindFirstChildOfClass("Humanoid") end

local function guiParent()
    local ok, p = pcall(function() return (gethui and gethui()) or game:GetService("CoreGui") end)
    if ok and p then return p end
    return LocalPlayer:WaitForChild("PlayerGui")
end

local function roleOf(p)
    local t = p.Team and p.Team.Name:lower() or ""
    if t:find("killer") then return "Killer" end
    if t:find("survivor") then return "Survivor" end
    if t:find("spectator") then return "Spectator" end
    local a = p:GetAttribute("Role")
    if type(a) == "string" then
        a = a:lower()
        if a:find("killer") then return "Killer" end
        if a:find("survivor") then return "Survivor" end
        if a:find("spectator") then return "Spectator" end
    end
    return "None"
end

local function myRole() return roleOf(LocalPlayer) end

local function isDown(c)
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return true end
    return (c:GetAttribute("Knockdown") or c:GetAttribute("IsDowned") or c:GetAttribute("IsCarried") or c:GetAttribute("IsHooked")) and true or false
end

local function stateOf(c)
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return "DEAD" end
    if c:GetAttribute("IsHooked") then return "HOOKED" end
    if c:GetAttribute("IsCarried") then return "CARRIED" end
    if c:GetAttribute("Knockdown") or c:GetAttribute("IsDowned") then return "DOWN" end
    return "OK"
end

local ItemsList = { "Adrenaline Shot", "Bandage", "Flashlight", "Motion Tracker", "Parrying Dagger", "Shadow Clone", "Twist of Fate", "WaxBound Candle" }
local ItemSet = {}
for _, n in ipairs(ItemsList) do ItemSet[n] = true end

local function heldItem(c)
    for _, v in ipairs(c:GetChildren()) do
        if ItemSet[v.Name] then return v.Name end
    end
    for _, v in ipairs(c:GetDescendants()) do
        if v:IsA("Model") and ItemSet[v.Name] then return v.Name end
    end
    return nil
end

local function insideCharacter(o)
    local a = o.Parent
    while a and a ~= Workspace do
        if Players:GetPlayerFromCharacter(a) then return true end
        a = a.Parent
    end
    return false
end

local function pivotPos(inst)
    local ok, p = pcall(function() return inst:GetPivot().Position end)
    if ok then return p end
    return nil
end

local function distTo(pos)
    local r = getRoot()
    if not r or not pos then return 9e9 end
    return (r.Position - pos).Magnitude
end

local function nearestPlayer(role, maxDist, ignoreDown)
    local r = getRoot()
    if not r then return nil, 0 end
    local best, bestD = nil, maxDist
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and roleOf(p) == role then
            local c = p.Character
            local pr = c and c:FindFirstChild("HumanoidRootPart")
            if pr and not (ignoreDown and isDown(c)) then
                local d = (pr.Position - r.Position).Magnitude
                if d < bestD then best, bestD = p, d end
            end
        end
    end
    return best, bestD
end

local function hasLOS(fromPos, targetChar)
    local tr = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not tr then return false end
    local filter = {}
    local mc = getChar()
    if mc then table.insert(filter, mc) end
    if Workspace.CurrentCamera then table.insert(filter, Workspace.CurrentCamera) end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = filter
    local res = Workspace:Raycast(fromPos, tr.Position - fromPos, rp)
    return (not res) or res.Instance:IsDescendantOf(targetChar)
end

local function faceTowards(pos)
    local r = getRoot()
    if not r then return end
    local flat = Vector3.new(pos.X, r.Position.Y, pos.Z)
    if (flat - r.Position).Magnitude < 0.1 then return end
    r.CFrame = CFrame.lookAt(r.Position, flat)
end

local function playAnim(id, priority, looped)
    local h = getHum()
    local an = h and h:FindFirstChildOfClass("Animator")
    if not an then return nil end
    local a = Instance.new("Animation")
    a.AnimationId = id
    local tr = an:LoadAnimation(a)
    tr.Priority = priority or Enum.AnimationPriority.Action4
    tr.Looped = looped or false
    tr:Play()
    return tr
end

