genv.R4NS0M_VD_Unload = function()
    if Unloaded then return end
    Unloaded = true
    for k in pairs(S) do if type(S[k]) == "boolean" then S[k] = false end end
    if Ghost.part or Ghost.ind then ghostOff() end
    setFakeKnock(false)
    setLowGfx(false)
    if CurrentAnim then CurrentAnim:Stop() end
    envTick()
    LocalPlayer.CameraMaxZoomDistance = 128
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    pcall(function() GuiHolder:Destroy() end)
    pcall(function() Window:Destroy() end)
    genv.R4NS0M_VD_Unload = nil
end

