local Maid = { conns = {}, tasks = {} }
function Maid:Add(c) table.insert(self.conns, c) return c end
function Maid:Task(f) table.insert(self.tasks, f) end
function Maid:Clean()
    for _, c in ipairs(self.conns) do pcall(function() c:Disconnect() end) end
    table.clear(self.conns)
    for _, f in ipairs(self.tasks) do pcall(f) end
    table.clear(self.tasks)
end

