--// ==================== TELEPORT SEGURO ====================
local Teleporting = false
local function safeTP(cf)
    if Teleporting then return end
    if not getRoot() then return end
    Teleporting = true; TempNoclip = true
    task.spawn(function()
        while Teleporting and not Unloaded do
            local r = getRoot(); if not r then break end
            local delta = cf.Position - r.Position
            local dist = delta.Magnitude
            if dist <= 3 then break end
            local step = math.min(dist, S.SafeTPSpeed * 0.03)
            r.CFrame = CFrame.new(r.Position + delta.Unit * step) * (r.CFrame - r.CFrame.Position)
            task.wait(0.03)
        end
        local r = getRoot()
        if Teleporting and r then r.CFrame = cf end
        Teleporting = false; TempNoclip = false
    end)
end

local function nearestOf(cat)
    local r = getRoot(); if not r then return nil end
    local best, bestD
    for inst, c in pairs(MapObjs) do
        if c == cat and inst.Parent then
            local part = adorneePart(inst)
            if part then
                local d = (part.Position - r.Position).Magnitude
                if not bestD or d < bestD then best, bestD = part, d end
            end
        end
    end
    return best
end

local function tpToCat(cat, label)
    local part = nearestOf(cat)
    if not part then notify("Error", "No " .. label .. " found on this map.", 3, "x"); return end
    safeTP(part.CFrame + Vector3.new(0, 5, 0))
    notify("Teleport", "Moving to nearest " .. label .. "...", 2, "navigation")
end

--// ==================== JACKET / VEIL / COMBATE ====================
local lastHit, lastAura, lastVeil, lastParry, lastTwist, lastSaw = 0, 0, 0, 0, 0, 0
local KillerMax = 16
local wallParams = RaycastParams.new()
wallParams.FilterType = Enum.RaycastFilterType.Exclude
wallParams.RespectCanCollide = true

local function wallBetween(targetChar)
    local ch = getChar(); local r = getRoot(); local tr = getRoot(targetChar)
    if not (ch and r and tr) then return false end
    if ch:GetAttribute("CanPierce") or ch:GetAttribute("SpearCharged") then return false end
    wallParams.FilterDescendantsInstances = { ch, cam() }
    local res = Workspace:Raycast(r.Position, tr.Position - r.Position, wallParams)
    return res ~= nil and not res.Instance:IsDescendantOf(targetChar)
end

local function veilDirection(targetChar)
    local c = cam()
    local tr = getRoot(targetChar)
    if not tr then return nil end
    if S.VeilWall and wallBetween(targetChar) then return nil end
    local pos = tr.Position + tr.AssemblyLinearVelocity * S.VeilPred
    if not S.VeilNoGrav then
        local d = (tr.Position - c.CFrame.Position).Magnitude
        pos = pos + Vector3.new(0, d / 100, 0)
    end
    return (pos - c.CFrame.Position).Unit
end

local function heartbeatTick(dt)
    local ch, h, r = getChar(), getHum(), getRoot()
    if not (ch and h and r) then return end
    local now = tick()

    -- TPWalk
    if S.TPWalk and h.MoveDirection.Magnitude > 0 then
        r.CFrame = r.CFrame + h.MoveDirection * (S.TPSpeed / 10) * (dt * 60)
    end

    -- Jump
    if S.JumpOn then
        h.UseJumpPower = true
        if h.JumpPower ~= S.JumpPower then h.JumpPower = S.JumpPower end
    end

    -- Killer: no slowdown
    if S.NoSlow then
        local attr = ch:GetAttribute("Speed")
        local target = (attr or KillerMax) * (ch:GetAttribute("speedboost") or 1)
        if h.WalkSpeed < target - 0.5 then
            h.WalkSpeed = target
        elseif not attr and h.WalkSpeed > KillerMax then
            KillerMax = h.WalkSpeed
        end
    end

    -- Killer: Auto Hit (legit)
    if S.AutoHit and now - lastHit >= S.HitCooldown then
        local t = nearestSurvivor(S.HitRange)
        if t and fireAttack() then
            lastHit = now
            if S.DoubleTap then task.delay(0.05, fireAttack) end
        end
    end

    -- Killer: Kill Aura (rage)
    if S.Aura and now - lastAura >= S.AuraDelay then
        local t = nearestSurvivor(S.AuraRange)
        if t and fireAttack() then
            lastAura = now
            if S.AuraDouble then task.delay(0.02, fireAttack) end
        end
    end

    -- Protecciones
    if S.AntiStun then
        if ch:GetAttribute("Stunned") then ch:SetAttribute("Stunned", false) end
        if ch:GetAttribute("IsStunned") then ch:SetAttribute("IsStunned", false) end
        if h.WalkSpeed < 2 then h.WalkSpeed = ch:GetAttribute("Speed") or 16 end
    end
    if S.AntiBlind then
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, n in ipairs({ "Blindness", "FlashlightEffect" }) do
                local g = pg:FindFirstChild(n)
                if g then
                    if g:IsA("ScreenGui") then g.Enabled = false
                    elseif g:IsA("GuiObject") then g.Visible = false end
                end
            end
        end
        if ch:GetAttribute("Blinded") then ch:SetAttribute("Blinded", false) end
    end

    -- Jacket
    if S.JacketOn then
        if ch:GetAttribute("Mask") ~= S.JacketMask then ch:SetAttribute("Mask", S.JacketMask) end
        if ch:GetAttribute("Swift") ~= S.JacketSwift then ch:SetAttribute("Swift", S.JacketSwift) end
        if ch:GetAttribute("lungeboost") ~= S.JacketLunge then ch:SetAttribute("lungeboost", S.JacketLunge) end
        if S.JacketSaw and S.JacketMask == "Alex" and now - lastSaw >= 0.2 then
            lastSaw = now
            pcall(function()
                local R = remotesRoot()
                local rm = R and R.Killers.Masked:FindFirstChild("alexattack")
                if rm then rm:FireServer() end
            end)
        end
    end

    -- Veil
    if S.VeilAim and (ch:FindFirstChild("Spear") or ch:GetAttribute("spearmode")) and now - lastVeil >= 0.45 then
        local t = nearestSurvivor(250)
        local rm = veilRemote()
        if t and rm then
            local dir = veilDirection(t.Character)
            if dir and (S.VeilAuto or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)) then
                lastVeil = now
                pcall(function() rm:FireServer(dir, S.VeilInstant and 165 or S.VeilForce) end)
            end
        end
    end

    -- Survivors: auto parry
    if S.AutoParry and now - lastParry >= 0.8 and ch:FindFirstChild("Parrying Dagger") then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and isKiller(p) and p.Character then
                local kr, kh = getRoot(p.Character), getHum(p.Character)
                if kr and kh then
                    local d = (r.Position - kr.Position).Magnitude
                    if d <= S.ParryDist then
                        local facing = kr.CFrame.LookVector:Dot((r.Position - kr.Position).Unit) > 0.2
                        local an = kh:FindFirstChildOfClass("Animator")
                        if facing and an then
                            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                                if not tr.Looped and tr.IsPlaying and tr.TimePosition < 0.6
                                    and tr.Priority.Value >= Enum.AnimationPriority.Action.Value then
                                    lastParry = now
                                    task.delay(S.ParryDelay, function()
                                        local rm = parryRemote()
                                        if rm then pcall(function() rm:FireServer() end) end
                                        if S.ParryAnim then playParryAnim() end
                                        if S.ParryFace then
                                            local rr = getRoot()
                                            if rr then
                                                rr.CFrame = CFrame.lookAt(rr.Position,
                                                    Vector3.new(kr.Position.X, rr.Position.Y, kr.Position.Z))
                                            end
                                        end
                                    end)
                                    break
                                end
                            end
                        end
                    end
                end
            end
            if lastParry == now then break end
        end
    end

    -- Survivors: no skillcheck screen
    if S.HideSkill then
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local g = pg and pg:FindFirstChild("SkillCheckPromptGui")
        if g and g.Enabled then g.Enabled = false end
    end

    -- Ghost view
    if Ghost.part then
        local up = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then up += 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then up -= 1 end
        local mv = h.MoveDirection + Vector3.new(0, up, 0)
        Ghost.part.CFrame = Ghost.part.CFrame + mv * S.GhostSpeed * dt
    end
end

local fastVaulted = setmetatable({}, { __mode = "k" })
local function renderTick()
    local ch, h = getChar(), getHum()
    if not (ch and h) then return end

    -- Killer aimbot
    if S.Aimbot then
        local t = nearestSurvivor(S.HitRange)
        local tr = t and getRoot(t.Character)
        if tr then aimAt(tr.Position, S.AimSmooth) end
    end

    -- Twist of Fate aimbot / autofire
    if S.TwistAim and (ch:FindFirstChild("Twist of Fate") or ch:FindFirstChild("Twist of fate")) then
        local k = nearestKiller(S.TwistRange)
        local kr = k and getRoot(k.Character)
        if kr then
            aimAt(kr.Position, S.TwistSmooth)
            if S.TwistFire and tick() - lastTwist >= 0.6 then
                local rm = twistRemote()
                if rm then
                    lastTwist = tick()
                    pcall(function() rm:FireServer(kr.Position) end)
                end
            end
        end
    end

    -- Fast vault
    if S.FastVault then
        local an = h:FindFirstChildOfClass("Animator")
        if an then
            for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                local n = tr.Name:lower()
                if (n:find("vault") or n:find("window")) and not fastVaulted[tr] then
                    fastVaulted[tr] = true
                    tr:AdjustSpeed(S.VaultSpeed)
                end
            end
        end
    end

    -- FOV
    if S.FOVOn then
        local c = cam(); if c then c.FieldOfView = S.FOV end
    end
end

