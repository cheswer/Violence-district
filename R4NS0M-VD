local function remote(...)
    local node = ReplicatedStorage:FindFirstChild("Remotes")
    for _, n in ipairs({ ... }) do
        if not node then return nil end
        node = node:FindFirstChild(n)
    end
    return node
end

local function findRemoteLike(folder, patterns, exclude)
    if not folder then return nil end
    for _, d in ipairs(folder:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local n = d.Name:lower()
            local bad = false
            for _, e in ipairs(exclude or {}) do if n:find(e) then bad = true end end
            if not bad then
                for _, p in ipairs(patterns) do
                    if n:find(p) then return d end
                end
            end
        end
    end
    return nil
end

local RemoteCache = {}
local function cached(key, fn)
    local r = RemoteCache[key]
    if r and r.Parent then return r end
    r = fn()
    RemoteCache[key] = r
    return r
end

