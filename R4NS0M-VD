-- ASTRAL SCOUT (cámara libre, el cuerpo se queda quieto)
local Astral = { On = false, Speed = 70, AutoExit = true, Yaw = 0, Pitch = 0, Pos = Vector3.zero, Saved = {}, Conn = nil }
local setAstral

setAstral = function(v)
    if v == Astral.On then return end
    local h, cam = getHum(), Workspace.CurrentCamera
    if v then
        if not (h and cam) then return end
        if UIS.TouchEnabled and not UIS.KeyboardEnabled then
            notify("Astral Scout", "Solo disponible en PC.", 3, "alert-triangle")
            return
        end
        Astral.On = true
        Astral.Saved = { ws = h.WalkSpeed, jp = h.JumpPower }
        h.WalkSpeed = 0
        h.JumpPower = 0
        cam.CameraType = Enum.CameraType.Scriptable
        local cf = cam.CFrame
        Astral.Pos = cf.Position
        local rx, ry = cf:ToOrientation()
        Astral.Pitch, Astral.Yaw = rx, ry
        Astral.Conn = RunService.RenderStepped:Connect(function(dt)
            if Unloaded then return end
            local c2 = Workspace.CurrentCamera
            if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
                local d = UIS:GetMouseDelta()
                Astral.Yaw = Astral.Yaw - d.X * 0.004
                Astral.Pitch = math.clamp(Astral.Pitch - d.Y * 0.004, -1.5, 1.5)
            else
                UIS.MouseBehavior = Enum.MouseBehavior.Default
            end
            local rot = CFrame.fromOrientation(Astral.Pitch, Astral.Yaw, 0)
            local dir = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + rot.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - rot.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + rot.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - rot.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.yAxis end
            if dir.Magnitude > 0 then Astral.Pos = Astral.Pos + dir.Unit * Astral.Speed * dt end
            c2.CFrame = CFrame.new(Astral.Pos) * rot

            if Astral.AutoExit then
                local k, d = nearestPlayer("Killer", 45, false)
                if k then
                    notify("Astral Scout", "Killer cerca! Volviendo a tu cuerpo.", 3, "alert-triangle")
                    setAstral(false)
                    if Elements.Astral then pcall(function() Elements.Astral:Set(false) end) end
                end
            end
        end)
    else
        Astral.On = false
        if Astral.Conn then Astral.Conn:Disconnect() Astral.Conn = nil end
        UIS.MouseBehavior = Enum.MouseBehavior.Default
        local hh = getHum()
        if hh then
            hh.WalkSpeed = Astral.Saved.ws or 16
            hh.JumpPower = Astral.Saved.jp or 50
        end
        local c2 = Workspace.CurrentCamera
        if c2 then
            c2.CameraType = Enum.CameraType.Custom
            if hh then c2.CameraSubject = hh end
        end
    end
end
Maid:Task(function() if Astral.On then setAstral(false) end end)

-- TELEPORT SEGURO
local TP = { Busy = false, Cancel = false, Speed = 130, Instant = false }

local function travelTo(cf)
    local r = getRoot()
    if not r then return end
    if TP.Busy then notify("Teleport", "Ya hay un viaje en curso.", 2, "alert-triangle") return end
    TP.Busy, TP.Cancel = true, false
    if TP.Instant then
        r.CFrame = cf
        TP.Busy = false
        return
    end
    Mv.ForceNoclip = Mv.ForceNoclip + 1
    task.spawn(function()
        local goal = cf.Position
        while not TP.Cancel and not Unloaded do
            local rr = getRoot()
            if not rr then break end
            local dt = RunService.Heartbeat:Wait()
            local cur = rr.Position
            local remaining = (goal - cur).Magnitude
            if remaining < 3 then break end
            local step = math.min(remaining, TP.Speed * dt)
            rr.CFrame = CFrame.new(cur + (goal - cur).Unit * step) * (rr.CFrame - rr.CFrame.Position)
            rr.AssemblyLinearVelocity = Vector3.zero
        end
        local rr = getRoot()
        if rr and not TP.Cancel and not Unloaded then rr.CFrame = cf end
        Mv.ForceNoclip = math.max(0, Mv.ForceNoclip - 1)
        TP.Busy = false
    end)
end

local function tpToInstance(inst, label)
    if not inst then notify("Teleport", "No encontré: " .. label, 3, "x") return end
    local p = pivotPos(inst)
    if not p then notify("Teleport", "No se pudo ubicar: " .. label, 3, "x") return end
    notify("Teleport", "Viajando a " .. label .. "...", 2, "navigation")
    travelTo(CFrame.new(p + Vector3.new(0, 4, 0)))
end

