local function getChar() return LocalPlayer.Character end
local function getRoot(c) c = c or LocalPlayer.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(c) c = c or LocalPlayer.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function cam() return Workspace.CurrentCamera end
local function teamName(p) return (p.Team and p.Team.Name) or "" end

local function isKiller(p)
    return teamName(p) == "Killer" or p:GetAttribute("Role") == "Killer"
end
local function isSurvivor(p) return teamName(p) == "Survivors" end

local function playerCat(p)
    local t = teamName(p)
    if isKiller(p) then return "Killer"
    elseif t == "Survivors" then return "Survivors"
    elseif t:find("Spectator") then return "Spectator" end
    return nil
end

local function notify(title, content, dur, icon)
    pcall(function()
        WindUI:Notify({ Title = title, Content = content, Duration = dur or 3, Icon = icon or "info" })
    end)
end

local function validTarget(p)
    local c = p.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if S.IgnoreKnocked and (c:GetAttribute("Knockdown") or c:GetAttribute("IsCarried")
        or c:GetAttribute("IsHooked") or c:GetAttribute("IsDowned")) then
        return false
    end
    return true
end

local function nearestSurvivor(range)
    local r = getRoot(); if not r then return nil end
    local best, bestD = nil, range
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isSurvivor(p) and validTarget(p) then
            local pr = getRoot(p.Character)
            if pr then
                local d = (r.Position - pr.Position).Magnitude
                if d < bestD then best, bestD = p, d end
            end
        end
    end
    return best, bestD
end

local function nearestKiller(range)
    local r = getRoot(); if not r then return nil end
    local best, bestD = nil, range
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isKiller(p) then
            local pr = getRoot(p.Character)
            if pr then
                local d = (r.Position - pr.Position).Magnitude
                if d < bestD then best, bestD = p, d end
            end
        end
    end
    return best, bestD
end

local function aimAt(pos, alpha)
    local c = cam(); if not c then return end
    c.CFrame = c.CFrame:Lerp(CFrame.new(c.CFrame.Position, pos), math.clamp(alpha, 0.01, 1))
end

local function loadTrack(id)
    local h = getHum(); if not h then return nil end
    local an = h:FindFirstChildOfClass("Animator") or Instance.new("Animator", h)
    local a = Instance.new("Animation"); a.AnimationId = id
    local ok, tr = pcall(function() return an:LoadAnimation(a) end)
    return ok and tr or nil
end

--// ==================== REMOTES (con busqueda segura) ====================
local RemoteCache = {}
local function remotesRoot() return ReplicatedStorage:FindFirstChild("Remotes") end

local function scanRemote(rootInst, keywords, exclude)
    if not rootInst then return nil end
    for _, k in ipairs(keywords) do
        for _, d in ipairs(rootInst:GetDescendants()) do
            if d:IsA("RemoteEvent") then
                local n = d.Name:lower()
                if n:find(k) and not (exclude and n:find(exclude)) then return d end
            end
        end
    end
end

local function cached(key, resolver)
    local r = RemoteCache[key]
    if r and r.Parent then return r end
    local ok, res = pcall(resolver)
    if ok and res then RemoteCache[key] = res; return res end
    return nil
end

local function attackRemote()
    return cached("attack", function()
        local R = remotesRoot()
        local direct = R and R:FindFirstChild("Attacks") and R.Attacks:FindFirstChild("BasicAttack")
        return direct or scanRemote(R, { "basicattack", "attack", "swing" }, "skill")
    end)
end

local function veilRemote()
    return cached("veil", function()
        local R = remotesRoot()
        local v = R and R:FindFirstChild("Killers") and R.Killers:FindFirstChild("Veil")
        return scanRemote(v, { "throw", "spear", "fire", "shoot" }, "vfx")
    end)
end

local function parryRemote()
    return cached("parry", function()
        local R = remotesRoot()
        local d = R and R:FindFirstChild("Items") and R.Items:FindFirstChild("Parrying Dagger")
        return d and d:FindFirstChild("parry")
    end)
end

local function twistRemote()
    return cached("twist", function()
        local R = remotesRoot()
        local d = R and R:FindFirstChild("Items") and R.Items:FindFirstChild("Twist of Fate")
        return d and d:FindFirstChild("Fire")
    end)
end

local function fireAttack()
    local r = attackRemote()
    if r then pcall(function() r:FireServer(false) end) return true end
    return false
end

