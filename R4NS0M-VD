local MatOrig = setmetatable({}, { __mode = "k" })
local origZoom = LocalPlayer.CameraMaxZoomDistance
local origFOV = (Workspace.CurrentCamera and Workspace.CurrentCamera.FieldOfView) or 70

local function restoreLighting()
    for k, v in pairs(LightOrig) do pcall(function() Lighting[k] = v end) end
    for atmo, d in pairs(AtmoOrig) do pcall(function() atmo.Density = d end) end
end
