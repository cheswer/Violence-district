removeEntry = function(inst)
    local e = Entries[inst]
    if not e then return end
    for _, k in ipairs({ "Hl", "Bb", "Box" }) do
        if e[k] then pcall(function() e[k]:Destroy() end) end
    end
    if e.Line then pcall(function() e.Line:Remove() end) end
    Entries[inst] = nil
end

local function adornPartOf(inst)
    if inst:IsA("BasePart") then return inst end
    return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
end

local function makeEntry(inst, kind, isPlayer)
    local part = isPlayer and (inst:FindFirstChild("Head") or inst:FindFirstChild("HumanoidRootPart")) or adornPartOf(inst)
    if not part then return nil end
    local e = { Inst = inst, Kind = kind, Player = isPlayer, Part = part }

    local bb = Instance.new("BillboardGui")
    bb.Name = "B"
    bb.Size = UDim2.fromOffset(240, 38)
    bb.StudsOffset = Vector3.new(0, isPlayer and 2.4 or 2, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = part
    bb.Parent = ESPFolder
    local lb = Instance.new("TextLabel")
    lb.BackgroundTransparency = 1
    lb.Size = UDim2.fromScale(1, 1)
    lb.TextStrokeTransparency = 0.3
    lb.Font = Enum.Font.GothamBold
    lb.Parent = bb
    e.Bb, e.Lbl = bb, lb

    if isPlayer then
        local h = Instance.new("Highlight")
        h.Adornee = inst
        h.OutlineColor = Color3.new(1, 1, 1)
        h.Parent = ESPFolder
        e.Hl = h
    else
        local box = Instance.new("BoxHandleAdornment")
        box.Adornee = part
        box.AlwaysOnTop = true
        box.ZIndex = 1
        if inst:IsA("Model") then
            local ok, cf, size = pcall(function() return inst:GetBoundingBox() end)
            if ok then
                box.CFrame = part.CFrame:ToObjectSpace(cf)
                box.Size = size
            else
                box.Size = part.Size
            end
        else
            box.Size = part.Size
        end
        box.Parent = ESPFolder
        e.Box = box
    end

    Entries[inst] = e
    return e
end

local function paintEntry(e, color, text)
    e.Lbl.Text = text
    e.Lbl.TextColor3 = color
    e.Lbl.TextSize = ESP.TextSize
    e.Bb.AlwaysOnTop = not ESP.OnlyVisible
    if e.Hl then
        e.Hl.FillColor = color
        e.Hl.FillTransparency = ESP.OutlineOnly and 1 or 0.55
        e.Hl.DepthMode = ESP.OnlyVisible and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
    end
    if e.Box then
        e.Box.Color3 = color
        e.Box.Transparency = ESP.OutlineOnly and 0.85 or 0.6
        e.Box.AlwaysOnTop = not ESP.OnlyVisible
    end
end

local function espTick()
    local me = getRoot()
    if not me then return end
    local seen = {}
    local role = myRole()

    -- Jugadores
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local c = p.Character
            local pr = c and c:FindFirstChild("HumanoidRootPart")
            local r = roleOf(p)
            local kind = (r == "Killer" or r == "Survivor" or r == "Spectator") and r or nil
            local on = kind and ESP.On[kind]
            if on and ESP.Smart then
                if kind == "Spectator" and role ~= "Spectator" then on = false end
            end
            if on and pr then
                local d = (pr.Position - me.Position).Magnitude
                if d <= ESP.MaxDist then
                    local e = Entries[c] or makeEntry(c, kind, true)
                    if e then
                        e.Kind = kind
                        seen[c] = true
                        local parts = {}
                        if ESP.Names then table.insert(parts, (kind == "Killer" and "[KILLER] " or "") .. p.Name) end
                        if ESP.Health then
                            local h = c:FindFirstChildOfClass("Humanoid")
                            if h and h.MaxHealth > 0 then table.insert(parts, math.floor(h.Health / h.MaxHealth * 100) .. "%") end
                            local st = stateOf(c)
                            if st ~= "OK" then table.insert(parts, st) end
                        end
                        if ESP.Held and kind == "Survivor" then
                            local it = heldItem(c)
                            if it then table.insert(parts, it) end
                        end
                        if ESP.Dist then table.insert(parts, math.floor(d) .. "m") end
                        paintEntry(e, ESP.Colors[kind], table.concat(parts, " | "))
                    end
                end
            end
        end
    end

    -- Objetos del mapa
    for kind, set in pairs(Cache) do
        if ESP.On[kind] then
            for inst in pairs(set) do
                if inst.Parent then
                    local pos = pivotPos(inst)
                    if pos then
                        local d = (pos - me.Position).Magnitude
                        local show = d <= ESP.MaxDist
                        local label = Labels[kind]
                        local color = ESP.Colors[kind]
                        if kind == "Generator" then
                            local pg = genProgress(inst)
                            if pg then
                                if pg >= 99.5 then
                                    if ESP.HideDoneGens then show = false end
                                    label = "Generator DONE"
                                    color = Color3.fromRGB(120, 120, 120)
                                else
                                    label = "Generator " .. math.floor(pg) .. "%"
                                end
                            end
                        elseif kind == "Item" then
                            label = inst.Name
                        end
                        if show then
                            local e = Entries[inst] or makeEntry(inst, kind, false)
                            if e then
                                seen[inst] = true
                                paintEntry(e, color, label .. (ESP.Dist and (" | " .. math.floor(d) .. "m") or ""))
                            end
                        end
                    end
                end
            end
        end
    end

    -- Limpieza
    for inst, e in pairs(Entries) do
        if not seen[inst] or not inst.Parent or not inst:IsDescendantOf(game) then
            removeEntry(inst)
        end
    end
end

