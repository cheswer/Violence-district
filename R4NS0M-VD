local CrossGui
local function buildCrosshair()
    if CrossGui then CrossGui:Destroy(); CrossGui = nil end
    if not S.Cross then return end
    CrossGui = Instance.new("ScreenGui")
    CrossGui.Name = "R4_VD_Cross"; CrossGui.ResetOnSpawn = false; CrossGui.IgnoreGuiInset = true
    CrossGui.Parent = GuiHolder
    local size = S.CrossSize
    if S.CrossId ~= "" then
        local img = Instance.new("ImageLabel")
        img.BackgroundTransparency = 1; img.AnchorPoint = Vector2.new(0.5, 0.5)
        img.Position = UDim2.fromScale(0.5, 0.5); img.Size = UDim2.fromOffset(size, size)
        img.Image = "rbxassetid://" .. S.CrossId:gsub("%D", "")
        img.ImageTransparency = S.CrossOpacity; img.ImageColor3 = S.CrossColor
        img.Parent = CrossGui
        return
    end
    local center = Instance.new("Frame")
    center.AnchorPoint = Vector2.new(0.5, 0.5); center.Position = UDim2.fromScale(0.5, 0.5)
    center.Size = UDim2.fromOffset(size, size); center.BackgroundTransparency = 1; center.Parent = CrossGui
    local function line(sz, pos)
        local f = Instance.new("Frame")
        f.BackgroundColor3 = S.CrossColor; f.BorderSizePixel = 0
        f.BackgroundTransparency = S.CrossOpacity; f.Size = sz; f.Position = pos; f.Parent = center
